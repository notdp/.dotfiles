<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.notdp.cargo-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/notdp/.cargo/bin/cargo</string>
    <string>sweep</string>
    <string>--recursive</string>
    <string>--time</string><string>7</string>
    <string>/Users/notdp/Developer</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/notdp/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/notdp/Library/Logs/cargo-sweep/out.log</string>
  <key>StandardErrorPath</key><string>/Users/notdp/Library/Logs/cargo-sweep/err.log</string>
</dict>
</plist>
